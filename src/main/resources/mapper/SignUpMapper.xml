<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.addreading.mybookapp.common.signUp.mapper.SignUpMapper">
    <!-- 자체 계정으로 회원가입하기 -->
    <insert id="insertMbrSignUp" parameterType="com.addreading.mybookapp.common.signUp.dto.SignUpDto">
        INSERT INTO member (
            member_id,
            member_pw,
            created_at
        ) VALUES (
            #{memberId},
            #{memberPw},
            #{createdAt}
        )
    </insert>

</mapper>